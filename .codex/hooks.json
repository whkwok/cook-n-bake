{
  "description": "Run the project checks after Codex edits files.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run check",
            "commandWindows": "npm run check",
            "timeout": 120,
            "statusMessage": "Checking edited files"
          }
        ]
      }
    ]
  }
}
